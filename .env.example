# Copy to .env and fill in values

# App
EYWA_APP_NAME=eywa
EYWA_APP_VERSION=0.1.0
EYWA_DEBUG=false
EYWA_APP_PORT=8000

# Security
EYWA_SECRET_KEY=change-me-in-production

# ClickHouse
EYWA_CLICKHOUSE_HOST=localhost
EYWA_CLICKHOUSE_PORT=19000
EYWA_CLICKHOUSE_DATABASE=eywa
EYWA_CLICKHOUSE_USERNAME=default
EYWA_CLICKHOUSE_PASSWORD=clickhouse
EYWA_CLICKHOUSE_DRIVER=native
EYWA_CLICKHOUSE_ECHO=false
EYWA_CLICKHOUSE_HTTP_PORT=18123
EYWA_CLICKHOUSE_NATIVE_PORT=19000
EYWA_CLICKHOUSE_STARTUP_TIMEOUT_SECONDS=60
EYWA_CLICKHOUSE_RETRY_INTERVAL_SECONDS=1

# RPC
EYWA_RPC_ENDPOINT=http://host.docker.internal:8545

# Scan
EYWA_START_BLOCK=24078090
EYWA_CHUNK_SIZE=10000
EYWA_MAX_WORKERS=16
EYWA_TRACE_ADDRESS_BATCH_SIZE=100

# Tracing
# debug        -> debug_traceBlockByNumber + callTracer (Geth; requires the debug namespace)
# trace_filter -> trace_filter (Erigon/OpenEthereum; requires the trace namespace)
EYWA_TRACE_BACKEND=debug
EYWA_TRACE_BLOCK_CONCURRENCY=8
EYWA_TRACE_TIMEOUT=120s
# How many blocks back from head the node can still trace. A pruned full node keeps state
# for ~128 blocks and answers "historical state is not available" for anything older, so the
# auto scanner clamps its window to this depth. Raise it only on an archive node.
EYWA_MAX_TRACE_DEPTH=100

# Reverse heuristics
EYWA_REVERSE_HEURISTICS_ENABLED=false
EYWA_REVERSE_HEURISTICS_TOP_LEVEL_FIELD=to
EYWA_REVERSE_HEURISTICS_MIN_PASS_SCORE=4
EYWA_REVERSE_HEURISTICS_TOP_LEVEL_MATCH_MIN=1
EYWA_REVERSE_HEURISTICS_TOP_LEVEL_MATCH_WEIGHT=2
EYWA_REVERSE_HEURISTICS_RAW_TX_MIN=2
EYWA_REVERSE_HEURISTICS_RAW_TX_WEIGHT=2
EYWA_REVERSE_HEURISTICS_POOL_COUNT_MIN=1
EYWA_REVERSE_HEURISTICS_POOL_COUNT_WEIGHT=1
EYWA_REVERSE_HEURISTICS_MATCHED_SWAP_MIN=1
EYWA_REVERSE_HEURISTICS_MATCHED_SWAP_WEIGHT=2
EYWA_REVERSE_HEURISTICS_PRICED_SWAP_MIN=1
EYWA_REVERSE_HEURISTICS_PRICED_SWAP_WEIGHT=1
EYWA_REVERSE_HEURISTICS_TOTAL_USD_MIN=1000
EYWA_REVERSE_HEURISTICS_TOTAL_USD_WEIGHT=2
EYWA_REVERSE_HEURISTICS_MAX_SWAP_USD_MIN=500
EYWA_REVERSE_HEURISTICS_MAX_SWAP_USD_WEIGHT=1
EYWA_REVERSE_HEURISTICS_LOG_SAMPLE_LIMIT=20

# Scheduler
# The cron interval must stay well inside EYWA_MAX_TRACE_DEPTH blocks of chain time, otherwise
# the scanner cannot catch up on what the node has already pruned and blocks get skipped.
EYWA_SCHEDULER_ENABLED=false
EYWA_SCHEDULER_CRON=*/2 * * * *
EYWA_SCHEDULER_TIMEZONE=UTC
EYWA_SCHEDULER_RUNS=1
